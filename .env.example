PORT=3000
DATABASE_PATH=/data/heimatschutz.sqlite

# =====================================================================
# Master-Konto einrichten (zwei Wege, einer reicht)
# =====================================================================
# Es stehen KEINE Passwörter mehr im Code. Das Master-Konto wird auf einem
# dieser beiden Wege eingerichtet:
#
# Weg A) Passwort direkt setzen (einfachste Variante, z. B. für lokal/Railway):
#   MASTER_ACCOUNT_PASSWORD ausfüllen. Dann ist das Konto sofort nutzbar.
# MASTER_ACCOUNT_PASSWORD=<als-secret-setzen>
#
# Weg B) Per Setup-Key und E-Mail (kein Passwort in der Umgebung):
#   MASTER_ACCOUNT_PASSWORD leer lassen und SMTP + MASTER_SETUP_EMAIL setzen.
#   Beim ersten Start erzeugt die App einen Einmal-Schlüssel und schickt ihn
#   per E-Mail. Im Login-Bildschirm unter "Master-Konto einrichten" Schlüssel
#   und neues Passwort eingeben. Ohne SMTP wird kein Klartext-Schlüssel ins
#   Server-Log geschrieben.
MASTER_SETUP_EMAIL=master@example.org
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=postfach@example.org
SMTP_PASSWORD=<als-secret-setzen>
SMTP_FROM=Heimatschutz Aargau <postfach@example.org>

# Optionales Startpasswort für die Seed-Teamkonten. Leer lassen = die
# Seed-Teamkonten bleiben gesperrt und neue Mitarbeitende registrieren sich
# ausschliesslich per Registrierungsschlüssel.
# DEFAULT_LOGIN_PASSWORD=<als-secret-setzen>

# Optional nur wenn unterschiedliche Startpasswörter pro Person gewünscht sind:
# SEED_USER_PASSWORDS_JSON={"lucia.vettori":"<als-secret-setzen>","aleksandar.nikolic":"<als-secret-setzen>"}

# =====================================================================
# Automatische Datenaufnahme
# Das Tool holt öffentliche Daten automatisch aus drei Quellen:
#   1) Amtsblatt Aargau  -> kantonsweite Hauptquelle für neue Baugesuche
#   2) Gemeindequellen   -> im Katalog hinterlegt, werden beim Sync abgesucht
#                           (HTML/PDF/RSS), inkl. Auto-Discovery der Baugesuchseite
#   3) AGIS / ArcGIS     -> Schutzprüfung (ISOS, Denkmalpflege) je Standort
# eBau/AGOV ist login-geschützt und wird NICHT automatisch gescrapt.
# =====================================================================

# Hauptquelle einschalten: das offizielle Amtsblatt des Kantons Aargau.
# Quelltyp "amtsblatt" wird an der URL automatisch erkannt.
SYNC_SOURCE_URL=https://amtsblatt.ag.ch/publikationen/

# Wie viele Ergebnisseiten je Sync gelesen werden. Jede Seite ~10 Publikationen,
# davon ~4 Baugesuche. Höher = mehr Historie, aber mehr Anfragen an die Behördenseite.
AMTSBLATT_MAX_PAGES=50

# true (Standard) geokodiert die Baugesuche live für die AGIS-Schutzprüfung.
# false = schneller Massen-Import ohne Last-Spitze; Schutzprüfung erfolgt später.
AMTSBLATT_GEOCODE=true

# Automatischer Wochen-Sync (läuft im Hintergrund).
AUTO_SYNC_ENABLED=true
AUTO_SYNC_INTERVAL_HOURS=168
AUTO_SYNC_RUN_ON_START=false

# Ablaufdatum / Aufbewahrung: unberührte Fälle, deren Auflagefrist länger als
# so viele Tage zurückliegt, werden beim Sync automatisch aus der Datenbank
# gelöscht. Vom Team bearbeitete Fälle (Notiz, Zuständige, Kommentar oder
# Status ungleich "neu") bleiben erhalten. 0 = nie löschen.
APPLICATION_RETENTION_DAYS=45

# Optional für geschützte AGIS-/ArcGIS-Quellen:
# SYNC_SOURCE_TOKEN=AGIS_ZUGRIFFSTOKEN

# =====================================================================
# Wartung, Backups und Protokoll
# =====================================================================
# Hintergrund-Wartung räumt abgelaufene Sessions und tote Schlüssel auf und
# kann regelmässige SQLite-Backups anlegen.
# MAINTENANCE_ENABLED=true
# MAINTENANCE_INTERVAL_HOURS=24

# Automatische SQLite-Backups (Standard aus). Bei true wird die DB in BACKUP_DIR
# kopiert (Default: <DB-Ordner>/backups) und auf BACKUP_RETENTION Dateien begrenzt.
# BACKUP_ENABLED=true
# BACKUP_DIR=/data/backups
# BACKUP_RETENTION=7

# Aufbewahrung der Audit-Log-Einträge in Tagen (0 = nie löschen).
# AUDIT_RETENTION_DAYS=365

# =====================================================================
# Bot-Schutz: Cloudflare Turnstile (optional)
# =====================================================================
# Beide Keys aus dem Cloudflare-Dashboard (Turnstile) setzen, dann ist der
# Schutz aktiv: Registrierung und Passwort-vergessen verlangen immer eine
# Bot-Prüfung, der Login erst ab dem 2. Versuch (nach einem Fehlschlag).
# Ohne Keys ist Turnstile vollständig deaktiviert.
# TURNSTILE_SITE_KEY=0x4AAAAAAA...      # öffentlich (Frontend-Widget)
# TURNSTILE_SECRET_KEY=0x4AAAAAAA...    # geheim (Server-Prüfung)
