PORT=3000
DATABASE_PATH=/data/heimatschutz.sqlite
MASTER_ACCOUNT_PASSWORD=HIER_EIN_ECHTES_SICHERES_MASTER_PASSWORT_SETZEN
DEFAULT_LOGIN_PASSWORD=HIER_EIN_ECHTES_SICHERES_TEAM_PASSWORT_SETZEN

# Optional nur wenn unterschiedliche Startpasswörter pro Person gewünscht sind:
# SEED_USER_PASSWORDS_JSON={"lucia.vettori":"StarkesPasswort1","aleksandar.nikolic":"StarkesPasswort2"}

# =====================================================================
# Automatische Datenaufnahme
# Das Tool holt oeffentliche Daten automatisch aus drei Quellen:
#   1) Amtsblatt Aargau  -> kantonsweite Hauptquelle fuer neue Baugesuche
#   2) Gemeindequellen   -> im Katalog hinterlegt, werden beim Sync abgesucht
#                           (HTML/PDF/RSS), inkl. Auto-Discovery der Baugesuchseite
#   3) AGIS / ArcGIS     -> Schutzpruefung (ISOS, Denkmalpflege) je Standort
# eBau/AGOV ist login-geschuetzt und wird NICHT automatisch gescrapt.
# =====================================================================

# Hauptquelle einschalten: das offizielle Amtsblatt des Kantons Aargau.
# Quelltyp "amtsblatt" wird an der URL automatisch erkannt.
SYNC_SOURCE_URL=https://amtsblatt.ag.ch/publikationen/

# Wie viele Ergebnisseiten je Sync gelesen werden. Jede Seite ~10 Publikationen,
# davon ~4 Baugesuche. Hoeher = mehr Historie, aber mehr Anfragen an die Behoerdenseite.
AMTSBLATT_MAX_PAGES=50

# true (Standard) geokodiert die Baugesuche live fuer die AGIS-Schutzpruefung.
# false = schneller Massen-Import ohne Last-Spitze; Schutzpruefung erfolgt spaeter.
AMTSBLATT_GEOCODE=true

# Automatischer Wochen-Sync (laeuft im Hintergrund).
AUTO_SYNC_ENABLED=true
AUTO_SYNC_INTERVAL_HOURS=168
AUTO_SYNC_RUN_ON_START=false

# Ablaufdatum / Aufbewahrung: unberuehrte Faelle, deren Auflagefrist laenger als
# so viele Tage zurueckliegt, werden beim Sync automatisch aus der Datenbank
# geloescht. Vom Team bearbeitete Faelle (Notiz, Zustaendige, Kommentar oder
# Status ungleich "neu") bleiben erhalten. 0 = nie loeschen.
APPLICATION_RETENTION_DAYS=45

# Optional fuer geschuetzte AGIS-/ArcGIS-Quellen:
# SYNC_SOURCE_TOKEN=AGIS_ZUGRIFFSTOKEN
